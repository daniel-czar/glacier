{
  "name": "glacier-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8280",
    "check:cloudflare": "wrangler deploy --dry-run --outdir artifacts/worker-dry-run",
    "check:http": "node scripts/check-http.mjs",
    "package": "node scripts/package.mjs",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "4.157.0" }
}
