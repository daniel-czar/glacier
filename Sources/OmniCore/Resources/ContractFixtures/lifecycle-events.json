  "states": ["submitted", "queued", "running", "succeeded", "failed", "cancelled", "interrupted", "proposing", "proposal_ready", "confirmed", "dismissed", "expired"],
  "event_fields": ["event_id", "run_id", "timestamp", "actor", "module_version", "manifest_version", "typed_detail"],
  "effect_order": ["effect_attempted", "effect_succeeded|effect_failed|effect_uncertain"],
